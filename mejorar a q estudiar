f_delta(o, c, v) =>
    float d = 0.0
    int n = array.size(v)
    if n > 1
        for k = 0 to n - 1
            float vv = nz(array.get(v, k))
            float oo = array.get(o, k)
            float cc = array.get(c, k)
            d += cc > oo ? vv : cc < oo ? -vv : 0.0
    d

// Max / Min delta intravela: extremos del delta acumulado mientras se formaba la vela
f_deltaMM(o, c, v) =>
    float run = 0.0
    float mx = 0.0
    float mn = 0.0
    int n = array.size(v)
    if n > 1
        for k = 0 to n - 1
            float vv = nz(array.get(v, k))
            float oo = array.get(o, k)
            float cc = array.get(c, k)
            run += cc > oo ? vv : cc < oo ? -vv : 0.0
            mx := math.max(mx, run)
            mn := math.min(mn, run)
    [mx, mn]

float proxyDelta = high > low ? volume * (2.0 * close - high - low) / (high - low) : 0.0
float barDelta   = array.size(ltV) > 1 ? f_delta(ltO, ltC, ltV) : proxyDelta
max_bars_back(barDelta, 500)   // VP / OB: acceso historico con offset dinamico al delta
[mmX, mmN] = f_deltaMM(ltO, ltC, ltV)
float dMax       = array.size(ltV) > 1 ? mmX : math.max(barDelta, 0.0)
float dMin       = array.size(ltV) > 1 ? mmN : math.min(barDelta, 0.0)
float dSum       = math.sum(barDelta, ofLen)
float vSum       = math.sum(volume, ofLen)
float flow       = vSum > 0 ? dSum / vSum : 0.0
float flowSd     = ta.stdev(flow, 100)
float ofScoreBase = flowSd > 0 ? math.max(-1.0, math.min(1.0, flow / (2.0 * flowSd))) : 0.0

// Delta % de la vela (delta / volumen) suavizado: +-oflPctInit % = score +-1
float barPct     = volume > 0 ? barDelta / volume : 0.0
float pctEma     = nz(ta.ema(barPct, 5))
float pctScore   = math.max(-1.0, math.min(1.0, pctEma / (oflPctInit / 100.0)))

// Sesgo por eventos de order flow (absorcion, divergencia, flip, rechazo, agotamiento); decae 10% por vela.
// Se actualiza en el modulo 3 (al final del script); aqui solo se lee el valor de la vela anterior.
var float oflEvBias = 0.0

float ofScore    = math.max(-1.0, math.min(1.0, (1.0 - oflBlend) * ofScoreBase + oflBlend * (0.5 * pctScore + 0.5 * oflEvBias)))

// ---- BBR (Bear Bull Ratio): cuota alcista = dist. alcista / (alcista + bajista) ----
float bbrBullPart = close > open ? (bbrTrue ? high - low : 1.0) : 0.0
float bbrBearPart = close < open ? (bbrTrue ? high - low : 1.0) : 0.0
float bbrBullSum  = nz(math.sum(bbrBullPart, bbrLen))
float bbrBearSum  = nz(math.sum(bbrBearPart, bbrLen))
float bbrTot      = bbrBullSum + bbrBearSum
float bbrRaw      = bbrTot > 0 ? bbrBullSum / bbrTot : 0.5
float bbrSm       = nz(ta.wma(bbrRaw, bbrSmooth), 0.5)
float bbrAvg      = ta.cum(bbrRaw) / (bar_index + 1)
float bbrSd       = ta.stdev(bbrRaw, 100)
float bbrScore    = bbrSd > 0 ? math.max(-1.0, math.min(1.0, (bbrSm - 0.5) / (2.0 * bbrSd))) : 0.0

// ---- Swings -> dealing range (Premium / Discount, CE) ----
ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)
var float swH = na
var float swL = na
if not na(ph)
    swH := ph
if not na(pl)
