if na(pShown)
    potVis := false
else if pShown * 100.0 >= minPotShow
    potVis := true
else if pShown * 100.0 < minPotShow - 5
    potVis := false

// ===================== DRAW =====================
var box tBox = na
var label tLbl = na
var table pnl = na
if barstate.islast
    f_clearDrawings()
    int xR = bar_index + 12      // borde derecho: 12 velas al futuro

    // Resumen del contador de aciertos
    int stNt = array.get(stN, 0) + array.get(stN, 1) + array.get(stN, 2)
    int stHt = array.get(stH, 0) + array.get(stH, 1) + array.get(stH, 2)
    float stPt = array.get(stP, 0) + array.get(stP, 1) + array.get(stP, 2)
