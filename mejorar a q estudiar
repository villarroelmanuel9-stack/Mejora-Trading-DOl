    float rPx = na
    int rStr = 0
    int rTime = bar_index
    string rTag = ""
    int n = array.size(liqPx)
    if n > 0
        for k = 0 to n - 1
            if array.get(liqDir, k) == wantDir
                float px = array.get(liqPx, k)
                bool ok = wantDir == 1 ? px > close : px < close
                if ok and (na(rPx) or (wantDir == 1 ? px < rPx : px > rPx))
                    rPx := px
                    rStr := array.get(liqStr, k)
                    rTime := array.get(liqTime, k)
                    rTag := wantDir == 1 ? (rStr >= 2 ? "EQH" : "BSL") : (rStr >= 2 ? "EQL" : "SSL")
    float[] hlv = wantDir == 1 ? array.from(pdh, pwh, pmh, array.get(sesLastH, 0), array.get(sesLastH, 1), array.get(sesLastH, 2)) : array.from(pdl, pwl, pml, array.get(sesLastL, 0), array.get(sesLastL, 1), array.get(sesLastL, 2))
    string[] htg = wantDir == 1 ? array.from("PDH", "PWH", "PMH", "ASIA H", "LDN H", "NY H") : array.from("PDL", "PWL", "PML", "ASIA L", "LDN L", "NY L")
    for k = 0 to 5
        if k == 0 or (k <= 2 and useHtfLiq) or (k >= 3 and useSesLiq)
            float hc = array.get(hlv, k)
            bool hok = not na(hc) and (wantDir == 1 ? hc > close : hc < close)
            if hok and (na(rPx) or (wantDir == 1 ? hc < rPx : hc > rPx))
                rPx := hc
                rStr := k == 0 ? 1 : 2
                rTime := bar_index - 30
                rTag := array.get(htg, k)
    [rPx, rStr, rTime, rTag]

// BeFVG mas cercano arriba (wantDir=-1) o BFVG mas cercano abajo (wantDir=1)
f_nearFvg(wantDir) =>
    float rLv = na
    string rTag = ""
    int n = array.size(zTop)
    if n > 0
        for k = 0 to n - 1
            if array.get(zDir, k) == wantDir and not array.get(zHit, k)
                float lv = f_lvl(array.get(zTop, k), array.get(zBot, k), wantDir)
                bool ok = wantDir == -1 ? lv > close : lv < close
                if ok and (na(rLv) or (wantDir == -1 ? lv < rLv : lv > rLv))
                    rLv := lv
                    rTag := (array.get(zInv, k) ? "i" : "") + (wantDir == 1 ? "BFVG" : "BeFVG")
    [rLv, rTag]

// Indice del BeOB (wantPol=-1) o BOB (wantPol=1) mas cercano al precio
f_nearOb(wantPol) =>
    int rI = -1
    float rD = 1.0e10
    int n = array.size(oTop)
    if n > 0
        for k = 0 to n - 1
            if array.get(oPol, k) == wantPol
                float hi = array.get(oTop, k)
                float lo = array.get(oBot, k)
                bool ok = wantPol == -1 ? hi > close : lo < close
                float dd = wantPol == -1 ? math.max(0.0, lo - close) : math.max(0.0, close - hi)
                if ok and dd < rD
                    rD := dd
                    rI := k
    rI

// Breaker block mas cercano: wantPol=1 alcista (soporte, abajo), -1 bajista (resistencia, arriba)
f_nearBrk(wantPol) =>
    int rI = -1
    float rD = 1.0e10
    int n = array.size(oTop)
    if n > 0
        for k = 0 to n - 1
            if array.get(oPol, k) == wantPol and array.get(oBrk, k)
                float hi = array.get(oTop, k)
                float lo = array.get(oBot, k)
                bool ok = wantPol == -1 ? hi > close : lo < close
                float dd = wantPol == -1 ? math.max(0.0, lo - close) : math.max(0.0, close - hi)
                if ok and dd < rD
                    rD := dd
                    rI := k
    rI

// Unicorn: el breaker se solapa con un FVG del mismo sentido (BFVG para BB alcista, BeFVG para BB bajista)
f_unicorn(i) =>
    bool u = false
    if i >= 0
        float hi = array.get(oTop, i)
        float lo = array.get(oBot, i)
        int p = array.get(oPol, i)
        int n = array.size(zTop)
        if n > 0
            for k = 0 to n - 1
                if array.get(zDir, k) == p and array.get(zBot, k) < hi and array.get(zTop, k) > lo
                    u := true
                    break
    u

