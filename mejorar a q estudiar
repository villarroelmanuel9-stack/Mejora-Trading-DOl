            label.set_text(tLbl, txt)
            label.set_color(tLbl, col)
            label.set_tooltip(tLbl, tip)
    else
        if not na(tBox)
            box.delete(tBox)
            tBox := na
        if not na(tLbl)
            label.delete(tLbl)
            tLbl := na

    // ---- Todos los BFVG / BeFVG rastreados (opcional) ----
    if showAllFvg
        int nZd = array.size(zTop)
        if nZd > 0
            for k = 0 to nZd - 1
                if not array.get(zHit, k) and array.get(zId, k) != tgtId
                    int kdr = array.get(zDir, k)
                    color kcol = kdr == -1 ? bullColor : bearColor
                    string ktxt = (array.get(zInv, k) ? "i" : "") + (kdr == 1 ? "BFVG" : "BeFVG")
                    array.push(xBox, box.new(math.max(array.get(zBorn, k), bMin), array.get(zTop, k), xR, array.get(zBot, k), border_color=color.new(kcol, 40), border_width=1, bgcolor=color.new(kcol, 92), text=ktxt, text_size=size.tiny, text_color=kcol, text_halign=text.align_right))

    // ---- BSL / SSL mas cercanos ----
    if showLiq
        if not na(bslPx)
            array.push(xLin, line.new(math.max(bslTm, bMin), bslPx, xR, bslPx, color=bslColor, style=line.style_dashed, width=bslStr >= 2 ? 2 : 1))
            array.push(xLbl, label.new(xR, bslPx, bslTag + " " + str.tostring(bslPx, format.mintick), style=label.style_label_left, color=color.new(bslColor, 100), textcolor=bslColor, size=size.small))
        if not na(sslPx)
            array.push(xLin, line.new(math.max(sslTm, bMin), sslPx, xR, sslPx, color=sslColor, style=line.style_dashed, width=sslStr >= 2 ? 2 : 1))
            array.push(xLbl, label.new(xR, sslPx, sslTag + " " + str.tostring(sslPx, format.mintick), style=label.style_label_left, color=color.new(sslColor, 100), textcolor=sslColor, size=size.small))

    // ---- BeOB / BOB mas cercanos (con linea del 50% = mean threshold) ----
    if showObZones
        if iBeOb != -1
            f_drawOb(iBeOb, beObColor, "BeOB", xR)
        if iBOb != -1
            f_drawOb(iBOb, bObColor, "BOB", xR)

    // ---- Breaker blocks (BB) mas cercanos; Unicorn = breaker + FVG del mismo sentido ----
