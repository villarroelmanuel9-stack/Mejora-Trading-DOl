// ===================== HELPERS =====================
f_ncdf(x) =>
    float t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    float w = 0.3989422804014327 * math.exp(-x * x / 2.0)
    float q = w * t * (0.31938153 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))))
    x >= 0.0 ? 1.0 - q : q

f_lvl(zt, zb, zd) =>
    touchMode == "CE (50%)" ? (zt + zb) / 2.0 : (zd == -1 ? zb : zt)

f_size(s) =>
