// ---- Probability engine: returns [POT, base, eDOL, eOF, eOB, ePD, eHTF, eBBR, eFVG, level, distATR, travelDir] ----
f_eval(i) =>
    float zt = array.get(zTop, i)
    float zb = array.get(zBot, i)
    int zd   = array.get(zDir, i)
    float lvl = f_lvl(zt, zb, zd)
    int d = zd == -1 ? 1 : -1                      // direccion que debe recorrer el precio para llegar a la zona
    float dist = math.abs(lvl - close)
    float distAtr = dist / atrVal

    // Base POT: principio de reflexion, P(touch) = 2 * (1 - Phi(dist / (sigma * sqrt(N))))
    float zs = dist / (sigmaUse * math.sqrt(horizonBars))
    float pBase = math.max(0.001, math.min(0.999, 2.0 * (1.0 - f_ncdf(zs))))

    // DOL: barrida reciente (ponderada por MSS) + BSL/SSL mas alla del target (EQH/EQL pesan mas) - pool opuesto cercano
    float sweepConf = not mssFilter ? 1.0 : mssState == 2 ? 1.0 : mssState == 1 ? 0.5 : 0.25
    float eSweep = 0.0
    if sweepBar >= 0
        int sAge = bar_index - sweepBar
        if sAge < sweepMem
            eSweep := d * sweepSig * (1.0 - sAge / sweepMem) * sweepConf * sweepW
    float pathVal = 0.0
    float oppVal = 0.0
    int nLiq = array.size(liqPx)
    if nLiq > 0
        for k = 0 to nLiq - 1
            float px = array.get(liqPx, k)
            int pDirK = array.get(liqDir, k)
            int pStr = array.get(liqStr, k)
            if pDirK == d
                if (d == 1 and px >= lvl) or (d == -1 and px <= lvl)
                    pathVal := math.max(pathVal, pStr >= 2 ? 1.25 : 1.0)
            else if math.abs(px - close) < dist * 0.5
                oppVal := math.max(oppVal, pStr >= 2 ? 0.75 : 0.5)
    // Liquidez externa por jerarquia: dia (PDH/PDL) < semana (PWH/PWL) < mes (PMH/PML)
    for k = 0 to 2
        if k == 0 or useHtfLiq
            float hv = array.get(gHi, k)
            float lw = array.get(gLo, k)
            if d == 1
                if not na(hv) and hv > close and hv >= lvl
                    pathVal := math.max(pathVal, array.get(gWPath, k))
                if not na(lw) and lw < close and math.abs(lw - close) < dist * 0.5
                    oppVal := math.max(oppVal, array.get(gWOpp, k))
            else
                if not na(lw) and lw < close and lw <= lvl
                    pathVal := math.max(pathVal, array.get(gWPath, k))
                if not na(hv) and hv > close and math.abs(hv - close) < dist * 0.5
                    oppVal := math.max(oppVal, array.get(gWOpp, k))

    // Liquidez de sesion (Asia / London / NY): ultimo maximo y minimo completado de cada una
    if useSesLiq
        for k = 0 to 2
            float sH2 = array.get(sesLastH, k)
            float sL2 = array.get(sesLastL, k)
            if d == 1
                if not na(sH2) and sH2 > close and sH2 >= lvl
                    pathVal := math.max(pathVal, sesLiqStr)
                if not na(sL2) and sL2 < close and math.abs(sL2 - close) < dist * 0.5
                    oppVal := math.max(oppVal, 0.5 * sesLiqStr)
            else
                if not na(sL2) and sL2 < close and sL2 <= lvl
                    pathVal := math.max(pathVal, sesLiqStr)
                if not na(sH2) and sH2 > close and math.abs(sH2 - close) < dist * 0.5
                    oppVal := math.max(oppVal, 0.5 * sesLiqStr)

    // FVG como DOL: otro FVG del mismo tipo que el target, mas alla de el, tambien atrae al precio
    bool fvgBeyond = false
    int nZb = array.size(zTop)
    if nZb > 0
        for k = 0 to nZb - 1
            if k != i and not array.get(zHit, k)
                int kdb = array.get(zDir, k)
                float lvlB = f_lvl(array.get(zTop, k), array.get(zBot, k), kdb)
                bool beyond = d == 1 ? lvlB > lvl : lvlB < lvl
                if kdb == -d and beyond and math.abs(lvlB - close) <= maxDistAtr * 1.5 * atrVal
                    fvgBeyond := true
    float eDol = math.max(-1.0, math.min(1.0, 0.55 * eSweep + 0.45 * (pathVal + (fvgBeyond ? fvgDolStr : 0.0) - oppVal)))

    // Order flow: presion de delta en la direccion del recorrido
    float eOf = d * ofScore

    // Order blocks: OB/breaker opuesto entre precio y target = obstaculo; OB a favor detras del precio = soporte
    int nObst = 0
    int nSupp = 0
    float bandLo = math.min(close, lvl)
    float bandHi = math.max(close, lvl)
    int nOb = array.size(oTop)
    if nOb > 0
        for k = 0 to nOb - 1
            float oMid = (array.get(oTop, k) + array.get(oBot, k)) / 2.0
            int oP = array.get(oPol, k)
            if oP == -d and oMid > bandLo and oMid < bandHi
                nObst += 1
            else if oP == d
                if d == 1 and oMid <= close and oMid >= close - obReachAtr * atrVal
                    nSupp += 1
                else if d == -1 and oMid >= close and oMid <= close + obReachAtr * atrVal
                    nSupp += 1
    float eOb = math.max(-1.0, math.min(1.0, (nSupp > 0 ? 0.5 : 0.0) - 0.5 * math.min(2, nObst)))

    // FVG: BFVG/BeFVG a favor detras del precio = apoyo; FVG opuesto entre precio y target = obstaculo
    int nFsup = 0
    int nFobs = 0
    int nZk = array.size(zTop)
    if nZk > 0
        for k = 0 to nZk - 1
            if k != i and not array.get(zHit, k)
                float kMid = (array.get(zTop, k) + array.get(zBot, k)) / 2.0
                int kd = array.get(zDir, k)
                if kd == -d and kMid > bandLo and kMid < bandHi
                    nFobs += 1
                else if kd == d
                    if d == 1 and kMid <= close and kMid >= close - obReachAtr * atrVal
                        nFsup += 1
                    else if d == -1 and kMid >= close and kMid <= close + obReachAtr * atrVal
                        nFsup += 1
    float eFvg = math.max(-1.0, math.min(1.0, (nFsup > 0 ? 0.5 : 0.0) - 0.5 * math.min(2, nFobs)))

    // Premium / Discount: subir desde discount, bajar desde premium
    float ePd = -d * pdPos

    // HTF bias
    float eHtf = d * htfBias

    // BBR: sesgo de velas alcistas vs bajistas en la direccion del recorrido
    float eBbr = d * bbrScore

    float tilt = wDol * eDol + wOf * eOf + wOb * eOb + wPd * ePd + wHtf * eHtf + wFvg * eFvg + wBbr * eBbr
    float lg = math.log(pBase / (1.0 - pBase)) + tilt
    float p = 1.0 / (1.0 + math.exp(-lg))
    [p, pBase, eDol, eOf, eOb, ePd, eHtf, eBbr, eFvg, lvl, distAtr, d]

// ===================== LIQUIDITY: SWEEPS + NEW POOLS (solo en barra confirmada) =====================
// Solo al cierre de barra: evita que en tiempo real un mismo pivote se agregue en cada tick y se fusione como EQH/EQL falso.
if barstate.isconfirmed
    int nL = array.size(liqPx)
    if nL > 0
        for i = nL - 1 to 0
            float lPx = array.get(liqPx, i)
            int lDir = array.get(liqDir, i)
            bool hitUp = lDir == 1 and high > lPx
            bool hitDn = lDir == -1 and low < lPx
            if hitUp or hitDn
                if hitUp and close < lPx
                    // BSL barrida (bajista): esperar MSS bajista = cierre bajo el ultimo swing low
                    sweepSig := -1
                    sweepBar := bar_index
                    sweepW := 1.0
                    sweepTag := ""
                    bslSweptNow := true
                    mssState := na(swL) ? 0 : 1
                    mssRef := swL
                    mssInv := high
                    mssArm := bar_index
                else if hitDn and close > lPx
                    // SSL barrida (alcista): esperar MSS alcista = cierre sobre el ultimo swing high
                    sweepSig := 1
                    sweepBar := bar_index
                    sweepW := 1.0
                    sweepTag := ""
                    sslSweptNow := true
                    mssState := na(swH) ? 0 : 1
                    mssRef := swH
                    mssInv := low
                    mssArm := bar_index
                f_rmLiq(i)
    // Barridas de liquidez externa (PDH/PDL, PWH/PWL, PMH/PML): mecha mas alla del nivel y cierre del lado contrario
    for k = 0 to 2
        if k == 0 or useHtfLiq
            float shv = array.get(gHi, k)
            float slv = array.get(gLo, k)
            if not na(shv) and high > shv and close < shv and high[1] <= shv
                sweepSig := -1
                sweepBar := bar_index
                sweepW := 1.0 + 0.25 * k
                sweepTag := array.get(gTagH, k)
                bslSweptNow := true
                mssState := na(swL) ? 0 : 1
                mssRef := swL
                mssInv := high
                mssArm := bar_index
            else if not na(slv) and low < slv and close > slv and low[1] >= slv
                sweepSig := 1
                sweepBar := bar_index
                sweepW := 1.0 + 0.25 * k
                sweepTag := array.get(gTagL, k)
                sslSweptNow := true
                mssState := na(swH) ? 0 : 1
                mssRef := swH
                mssInv := low
                mssArm := bar_index
    // Barridas de extremos de sesion (Asia / London / NY): mecha mas alla y cierre del lado contrario
    if useSesLiq
        float[] sHL = array.from(array.get(sesLastH, 0), array.get(sesLastH, 1), array.get(sesLastH, 2))
        float[] sLL = array.from(array.get(sesLastL, 0), array.get(sesLastL, 1), array.get(sesLastL, 2))
        string[] sNm = array.from("ASIA", "LDN", "NY")
        for k = 0 to 2
            float xh = array.get(sHL, k)
            float xl = array.get(sLL, k)
            if not na(xh) and high > xh and close < xh and high[1] <= xh
                sweepSig := -1
                sweepBar := bar_index
                sweepW := 1.1
                sweepTag := array.get(sNm, k) + " H"
                bslSweptNow := true
                mssState := na(swL) ? 0 : 1
                mssRef := swL
                mssInv := high
                mssArm := bar_index
            else if not na(xl) and low < xl and close > xl and low[1] >= xl
                sweepSig := 1
                sweepBar := bar_index
                sweepW := 1.1
                sweepTag := array.get(sNm, k) + " L"
                sslSweptNow := true
                mssState := na(swH) ? 0 : 1
                mssRef := swH
                mssInv := low
                mssArm := bar_index
    if not na(ph)
        f_addLiq(ph, 1, bar_index - pivotRight)
    if not na(pl)
        f_addLiq(pl, -1, bar_index - pivotRight)

// ===================== MSS: confirmacion de estructura tras la barrida =====================
if barstate.isconfirmed and mssState == 1
    bool bullBrk = sweepSig == 1 and close > mssRef and close > open and (close - open) >= mssBodyAtr * nz(atrVal)
    bool bearBrk = sweepSig == -1 and close < mssRef and close < open and (open - close) >= mssBodyAtr * nz(atrVal)
    bool mssFailed = (sweepSig == 1 and close < mssInv) or (sweepSig == -1 and close > mssInv)
    bool mssExpired = bar_index - mssArm > mssWindow
    if bullBrk
        mssState := 2
        mssDir := 1
        mssBar := bar_index
        newMssBull := true
    else if bearBrk
        mssState := 2
        mssDir := -1
        mssBar := bar_index
        newMssBear := true
    else if mssFailed or mssExpired
        mssState := 3

// ===================== ESTRUCTURA: BOS (continuacion) vs MSS (cambio de tendencia) =====================
// Cierre mas alla del ultimo swing. Si va a favor de la tendencia previa = BOS; si la invierte = MSS.
var float stRefH = na
var float stRefL = na
var bool  stHBrk = true
var bool  stLBrk = true
var int   stTrend = 0
var int   stEvDir = 0
var int   stEvBar = -1
var string stEvTxt = "-"
if not na(ph)
    stRefH := ph
    stHBrk := false
if not na(pl)
    stRefL := pl
    stLBrk := false
if barstate.isconfirmed
    if not stHBrk and close > stRefH
        stHBrk := true
        stEvTxt := (stTrend == -1 ? "MSS" : "BOS") + " alcista"
        stTrend := 1
        stEvDir := 1
        stEvBar := bar_index
    else if not stLBrk and close < stRefL
        stLBrk := true
        stEvTxt := (stTrend == 1 ? "MSS" : "BOS") + " bajista"
        stTrend := -1
        stEvDir := -1
        stEvBar := bar_index

// ===================== ORDER BLOCK LIFECYCLE =====================
int nO = array.size(oTop)
if nO > 0
    for i = nO - 1 to 0
        float oHi = array.get(oTop, i)
        float oLo = array.get(oBot, i)
        int oPi = array.get(oPol, i)
        bool oIsBrk = array.get(oBrk, i)
        float oMidI = (oHi + oLo) / 2.0
        if bar_index - array.get(oBorn, i) > maxAgeBars
            f_rmOb(i)
        else if not oIsBrk
            if oPi == 1 and close < oMidI
                array.set(oPol, i, -1)
                array.set(oBrk, i, true)
            else if oPi == -1 and close > oMidI
                array.set(oPol, i, 1)
                array.set(oBrk, i, true)
        else if (oPi == -1 and close > oHi) or (oPi == 1 and close < oLo)
            f_rmOb(i)

// ===================== FVG LIFECYCLE (touch / inversion / expiry) =====================
bool tgtHitNow = false
int nZ = array.size(zTop)
if nZ > 0
    for i = nZ - 1 to 0
        float zt = array.get(zTop, i)
        float zb = array.get(zBot, i)
        int zd = array.get(zDir, i)
        bool zInvI = array.get(zInv, i)
        bool zHitI = array.get(zHit, i)
        bool tooOld = bar_index - array.get(zBorn, i) > maxAgeBars
        bool crossed = (zd == 1 and close < zb) or (zd == -1 and close > zt)
        if tooOld
            f_rmZone(i)
        else if crossed
            if useIfvg and not zInvI
                array.set(zDir, i, -zd)
                array.set(zInv, i, true)
                array.set(zHit, i, false)
            else
                f_rmZone(i)
        else if not zHitI
            float lv = f_lvl(zt, zb, zd)
            bool touched = zd == -1 ? high >= lv : low <= lv
            if touched
                array.set(zHit, i, true)
                if array.get(zId, i) == tgtId
                    tgtHitNow := true

// ===================== NEW FVG (BFVG / BeFVG) + ORDER BLOCK (BOB / BeOB) =====================
bool gapBull = high[2] < low
bool gapBear = low[2] > high
float bodyD  = math.abs(close[1] - open[1])
float rngD   = high[1] - low[1]
bool strongD = rngD > 0 and bodyD / rngD >= 0.5 and bodyD >= atrVal * minFvgAtr
bool dispBull = strongD and close[1] > open[1]
bool dispBear = strongD and close[1] < open[1]

if barstate.isconfirmed and gapBull and dispBull
    idCounter += 1
    newBFvg := true
    f_pushZone(low, high[2], 1, bar_index - 2, time[2], idCounter)
    // BOB: ultima vela bajista antes del desplazamiento alcista
    int kB = close[2] < open[2] ? 2 : close[3] < open[3] ? 3 : close[4] < open[4] ? 4 : 0
    if kB > 0
        float obT = kB == 2 ? high[2] : kB == 3 ? high[3] : high[4]
        float obB = kB == 2 ? low[2] : kB == 3 ? low[3] : low[4]
        int obTm = kB == 2 ? time[2] : kB == 3 ? time[3] : time[4]
        f_pushOb(obT, obB, 1, bar_index - kB, obTm)
        newBOb := true

if barstate.isconfirmed and gapBear and dispBear
    idCounter += 1
    newBeFvg := true
    f_pushZone(low[2], high, -1, bar_index - 2, time[2], idCounter)
    // BeOB: ultima vela alcista antes del desplazamiento bajista
    int kR = close[2] > open[2] ? 2 : close[3] > open[3] ? 3 : close[4] > open[4] ? 4 : 0
    if kR > 0
        float obT2 = kR == 2 ? high[2] : kR == 3 ? high[3] : high[4]
        float obB2 = kR == 2 ? low[2] : kR == 3 ? low[3] : low[4]
        int obTm2 = kR == 2 ? time[2] : kR == 3 ? time[3] : time[4]
        f_pushOb(obT2, obB2, -1, bar_index - kR, obTm2)
        newBeOb := true

// ===================== TARGET SELECTION (single target + hysteresis) =====================
int bestI = -1
float bestSc = -1.0
int curI = -1
float curSc = -1.0
float curDist = na
int nZ2 = array.size(zTop)
if calcOn and nZ2 > 0 and not na(atrVal) and atrVal > 0
    for i = 0 to nZ2 - 1
        if not array.get(zHit, i)
            bool isCur = array.get(zId, i) == tgtId
            [cP, cPb, cDol, cOf, cOb, cPd, cHtf, cBbr, cFvg, cLvl, cDist, cDir] = f_eval(i)
            bool okDist = isCur ? cDist <= maxDistAtr * 1.5 : (cDist >= minDistAtr and cDist <= maxDistAtr)
            if okDist
                float sc = cP * math.min(cDist, capAtr)
                if sc > bestSc
                    bestSc := sc
                    bestI := i
                if isCur
                    curI := i
                    curSc := sc
                    curDist := cDist

bool targetChanged = false
int newId = tgtId
bool lockCur = curI != -1 and curDist < minDistAtr      // el precio ya esta cerca: mantener target hasta tocarlo
if curI != -1
    if not lockCur and bestI != -1 and bestI != curI and bestSc > curSc * (1.0 + hystPct / 100.0)
        newId := array.get(zId, bestI)
else
    newId := bestI != -1 ? array.get(zId, bestI) : -1
if newId != tgtId
    targetChanged := newId != -1
    tgtId := newId
    tgtSince := bar_index

// ---- Final evaluation of the active target ----
float fP   = na
float fPb  = na
float fDol = na
float fOf  = na
float fOb  = na
float fPd  = na
float fHtf = na
float fBbr = na
float fFvg = na
float fLvl = na
int   fDir = 0
if tgtId != -1 and not na(atrVal) and atrVal > 0
    int tI = array.indexof(zId, tgtId)
    if tI != -1
        [rP, rPb, rDol, rOf, rOb, rPd, rHtf, rBbr, rFvg, rLvl, rDist, rDir] = f_eval(tI)
        fP := rP
        fPb := rPb
        fDol := rDol
        fOf := rOf
        fOb := rOb
        fPd := rPd
        fHtf := rHtf
        fBbr := rBbr
        fFvg := rFvg
        fLvl := rLvl
        fDir := rDir

var float pShown = na
if na(fP)
    pShown := na
else if targetChanged or na(pShown)
    pShown := fP
else
    pShown := pShown + 0.35 * (fP - pShown)

// FIX: acceso historico en ambito global (se evalua en TODAS las barras). Antes pShown[5] solo se evaluaba
// en la ultima barra dentro de barstate.islast, y Pine no puede dimensionar el buffer asi -> error de offset.
float pShown5 = pShown[5]
max_bars_back(pShown, 500)

// ===================== ACCURACY TRACKER (POT estimado vs lo que paso) =====================
// Cada target nuevo = una prediccion: "el precio tocara el nivel dentro de horizonBars velas con prob. POT".
// Se resuelve por nivel (no depende de si el target cambia despues). Solo en barra confirmada.
if barstate.isconfirmed
    int nPd = array.size(pLvl)
    if nPd > 0
        for i = nPd - 1 to 0
            int pAge = bar_index - array.get(pStart, i)
            if pAge >= 1
                float lvT = array.get(pLvl, i)
                bool hitT = array.get(pDirA, i) == 1 ? high >= lvT : low <= lvT
                if hitT or pAge >= horizonBars
                    float potT = array.get(pPotA, i)
                    int bk = f_bucket(potT)
                    array.set(stN, bk, array.get(stN, bk) + 1)
                    array.set(stH, bk, array.get(stH, bk) + (hitT ? 1 : 0))
                    array.set(stP, bk, array.get(stP, bk) + potT)
                    array.remove(pLvl, i)
                    array.remove(pDirA, i)
                    array.remove(pStart, i)
                    array.remove(pPotA, i)
    if targetChanged and not na(fP) and fDir != 0 and not na(fLvl)
        array.push(pLvl, fLvl)
        array.push(pDirA, fDir)
        array.push(pStart, bar_index)
        array.push(pPotA, fP)
        if array.size(pLvl) > 300
            array.shift(pLvl)
            array.shift(pDirA)
            array.shift(pStart)
            array.shift(pPotA)

// ===================== PANEL MULTI-TEMPORALIDAD (sesgo + POT por temporalidad) =====================
// Version compacta del motor por temporalidad: sesgo = HTF (EMA50) + Order Flow (proxy de delta) + BBR - Premium/Discount,
// con los mismos pesos del POT. Objetivo = ultimo swing (liquidez) en la direccion del sesgo; POT = caminata aleatoria
// hacia ese nivel ajustada en log-odds por el sesgo. No incluye FVG/OB/barridas (eso solo lo hace el target del grafico).
f_tf() =>
    float a = ta.atr(14)
    float sig = nz(a) * 0.6
    float e50 = ta.ema(close, 50)
    float bias = close > e50 ? 1.0 : close < e50 ? -1.0 : 0.0
    float phx = ta.pivothigh(high, 5, 5)
    float plx = ta.pivotlow(low, 5, 5)
    var float sh = na
    var float sl = na
    if not na(phx)
        sh := phx
    if not na(plx)
        sl := plx
    float dl = high > low ? volume * (2.0 * close - high - low) / (high - low) : 0.0
    float vs = math.sum(volume, ofLen)
    float fl = vs > 0 ? math.sum(dl, ofLen) / vs : 0.0
    float ofs = math.max(-1.0, math.min(1.0, fl / 0.20))
    float bu = math.sum(close > open ? high - low : 0.0, bbrLen)
    float be = math.sum(close < open ? high - low : 0.0, bbrLen)
    float bt = bu + be
    float br = bt > 0 ? bu / bt : 0.5
    float bsm = nz(ta.ema(br, bbrSmooth), 0.5)
    float bs = math.max(-1.0, math.min(1.0, (bsm - 0.5) / 0.15))
    bool rOk = not na(sh) and not na(sl) and sh > sl
    float pd = rOk ? math.max(-1.0, math.min(1.0, (close - (sh + sl) / 2.0) / ((sh - sl) / 2.0))) : 0.0
    float raw = wHtf * bias + wOf * ofs + wBbr * bs - wPd * pd
    int d = raw > 0 ? 1 : raw < 0 ? -1 : 0
    float tgt = d == 1 ? ((not na(sh) and sh > close) ? sh : close + 2.0 * nz(a)) : d == -1 ? ((not na(sl) and sl < close) ? sl : close - 2.0 * nz(a)) : na
    float p = na
    if d != 0 and not na(tgt) and sig > 0
        float zs = math.abs(tgt - close) / (sig * math.sqrt(horizonBars))
        float pb = math.max(0.001, math.min(0.999, 2.0 * (1.0 - f_ncdf(zs))))
        float lg = math.log(pb / (1.0 - pb)) + math.abs(raw)
        p := 1.0 / (1.0 + math.exp(-lg))
    [d, p, tgt]

float tfD1 = na
float tfP1 = na
float tfT1 = na
float tfD15 = na
float tfP15 = na
float tfT15 = na
float tfD60 = na
float tfP60 = na
float tfT60 = na
float tfD240 = na
float tfP240 = na
float tfT240 = na
if tfOn   // con el panel apagado no se pide ninguna temporalidad (ahorra tiempo de ejecucion)
    [qD1, qP1, qT1] = request.security(syminfo.tickerid, "1", f_tf())
    tfD1 := qD1
    tfP1 := qP1
    tfT1 := qT1
    [qD15, qP15, qT15] = request.security(syminfo.tickerid, "15", f_tf())
    tfD15 := qD15
    tfP15 := qP15
    tfT15 := qT15
    [qD60, qP60, qT60] = request.security(syminfo.tickerid, "60", f_tf())
    tfD60 := qD60
    tfP60 := qP60
    tfT60 := qT60
    [qD240, qP240, qT240] = request.security(syminfo.tickerid, "240", f_tf())
    tfD240 := qD240
    tfP240 := qP240
    tfT240 := qT240

var table tfTbl = table.new(tfPosV, 4, 7, bgcolor=color.new(#131722, 10), frame_color=color.new(color.gray, 60), frame_width=1, border_color=color.new(color.gray, 70), border_width=1)

f_tfRow(r, nm, d, p, tgt) =>
    color c = d == 1 ? color.new(color.lime, 0) : d == -1 ? color.new(color.red, 0) : color.new(color.silver, 0)
    string dirTxt = d == 1 ? "▲ ALCISTA" : d == -1 ? "▼ BAJISTA" : "– neutral"
    string pTxt = na(p) ? "-" : str.tostring(math.round(p * 100.0)) + "%" + (p * 100.0 >= minPotShow ? " ✔" : "")
    table.cell(tfTbl, 0, r, nm, text_color=color.new(color.white, 20), text_halign=text.align_left, text_size=size.small)
    table.cell(tfTbl, 1, r, dirTxt, text_color=c, text_halign=text.align_left, text_size=size.small)
    table.cell(tfTbl, 2, r, pTxt, text_color=c, text_halign=text.align_left, text_size=size.small)
    table.cell(tfTbl, 3, r, na(tgt) ? "-" : str.tostring(tgt, format.mintick), text_color=color.new(color.white, 20), text_halign=text.align_left, text_size=size.small)

if barstate.islast and tfOn
    table.cell(tfTbl, 0, 0, "TF", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(tfTbl, 1, 0, "Sesgo", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(tfTbl, 2, 0, "POT", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(tfTbl, 3, 0, "Objetivo", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    f_tfRow(1, "Grafico " + timeframe.period, fDir, na(pShown) ? na : pShown, fLvl)
    f_tfRow(2, "1 min", tfD1, tfP1, tfT1)
    f_tfRow(3, "15 min", tfD15, tfP15, tfT15)
    f_tfRow(4, "1 hora", tfD60, tfP60, tfT60)
    f_tfRow(5, "4 horas", tfD240, tfP240, tfT240)
    int tfBull = (tfD1 == 1 ? 1 : 0) + (tfD15 == 1 ? 1 : 0) + (tfD60 == 1 ? 1 : 0) + (tfD240 == 1 ? 1 : 0)
    int tfBear = (tfD1 == -1 ? 1 : 0) + (tfD15 == -1 ? 1 : 0) + (tfD60 == -1 ? 1 : 0) + (tfD240 == -1 ? 1 : 0)
    int tfAgree = fDir == 1 ? tfBull : fDir == -1 ? tfBear : 0
    string tfConf = fDir == 0 ? str.tostring(tfBull) + "▲ / " + str.tostring(tfBear) + "▼" : str.tostring(tfAgree) + "/4 a favor del target"
    color tfConfCol = fDir == 0 ? color.new(color.silver, 0) : tfAgree >= 3 ? color.new(color.lime, 0) : tfAgree <= 1 ? color.new(color.red, 0) : color.new(color.yellow, 0)
    table.cell(tfTbl, 0, 6, "Confluencia", text_color=color.new(color.white, 20), text_halign=text.align_left, text_size=size.small)
    table.cell(tfTbl, 1, 6, tfConf, text_color=tfConfCol, text_halign=text.align_left, text_size=size.small)
    table.merge_cells(tfTbl, 1, 6, 3, 6)

// Visibilidad del target segun umbral de POT (con histeresis de 5 puntos)
