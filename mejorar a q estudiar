        if iBbR != -1 and iBbR != iBeOb
            f_drawOb(iBbR, beObColor, f_unicorn(iBbR) ? "BB- Unicorn" : "BB-", xR)

    // ---- Panel de contexto ----
    if showPanel
        if na(pnl)
            pnl := table.new(panelPos == "Top Left" ? position.top_left : panelPos == "Top Right" ? position.top_right : panelPos == "Bottom Left" ? position.bottom_left : position.bottom_right, 2, showStats ? 15 : 13, bgcolor=color.new(#131722, 10), frame_color=color.new(color.gray, 60), frame_width=1, border_color=color.new(color.gray, 70), border_width=1)
        color bbrCol = bbrSm > 0.55 ? color.new(color.lime, 0) : bbrSm < 0.45 ? color.new(color.red, 0) : color.new(color.silver, 0)
        int bullPct = math.round(bbrSm * 100.0)
        string swTxt = "-"
        if sweepBar >= 0
            swTxt := (sweepTag != "" ? sweepTag : (sweepSig == 1 ? "SSL" : "BSL")) + " barrida " + (sweepSig == 1 ? "▲" : "▼") + " · hace " + str.tostring(bar_index - sweepBar) + " velas"
        string mssTxt = "-"
        color mssCol = color.new(color.silver, 0)
        if mssState == 1
            mssTxt := "esperando MSS " + (sweepSig == 1 ? "▲" : "▼") + " (" + str.tostring(math.max(0, mssWindow - (bar_index - mssArm))) + " velas)"
            mssCol := color.new(color.yellow, 0)
        else if mssState == 2
            mssTxt := "MSS " + (mssDir == 1 ? "▲ alcista" : "▼ bajista") + " · hace " + str.tostring(bar_index - mssBar) + " velas"
            mssCol := mssDir == 1 ? color.new(color.lime, 0) : color.new(color.red, 0)
        else if mssState == 3
            mssTxt := "barrida sin MSS"
        table.cell(pnl, 0, 0, "Trading DOL 1.0", text_color=color.white, text_halign=text.align_left, text_size=size.small)
        table.cell(pnl, 1, 0, modeInput + " · " + str.tostring(horizonBars) + " velas", text_color=color.new(color.white, 20), text_halign=text.align_left, text_size=size.small)
        f_row(pnl, 1, "BBR bull/bear", str.tostring(bullPct) + "% / " + str.tostring(100 - bullPct) + "%  (media " + str.tostring(math.round(bbrAvg * 100.0)) + "%)", bbrCol)
        f_row(pnl, 2, "BSL ▲", na(bslPx) ? "-" : bslTag + " " + f_distTxt(bslPx), bslColor)
        f_row(pnl, 3, "SSL ▼", na(sslPx) ? "-" : sslTag + " " + f_distTxt(sslPx), sslColor)
        f_row(pnl, 4, "BeFVG ▲", na(beFvgLv) ? "-" : beFvgTag + " " + f_distTxt(beFvgLv), bullColor)
        f_row(pnl, 5, "BFVG ▼", na(bFvgLv) ? "-" : bFvgTag + " " + f_distTxt(bFvgLv), bearColor)
        f_row(pnl, 6, "BeOB ▲", iBeOb == -1 ? "-" : str.tostring(array.get(oBot, iBeOb), format.mintick) + " - " + str.tostring(array.get(oTop, iBeOb), format.mintick) + (array.get(oBrk, iBeOb) ? " brk" : ""), beObColor)
        f_row(pnl, 7, "BOB ▼", iBOb == -1 ? "-" : str.tostring(array.get(oBot, iBOb), format.mintick) + " - " + str.tostring(array.get(oTop, iBOb), format.mintick) + (array.get(oBrk, iBOb) ? " brk" : ""), bObColor)
        f_row(pnl, 8, "Ultima barrida", swTxt, color.new(color.white, 0))
        f_row(pnl, 9, "Estructura MSS", mssTxt, mssCol)
        f_row(pnl, 10, "BB ▲ (alcista)", iBbB == -1 ? "-" : str.tostring(array.get(oBot, iBbB), format.mintick) + " - " + str.tostring(array.get(oTop, iBbB), format.mintick) + (f_unicorn(iBbB) ? "  UNICORN" : ""), bObColor)
        f_row(pnl, 11, "BB ▼ (bajista)", iBbR == -1 ? "-" : str.tostring(array.get(oBot, iBbR), format.mintick) + " - " + str.tostring(array.get(oTop, iBbR), format.mintick) + (f_unicorn(iBbR) ? "  UNICORN" : ""), beObColor)
        f_row(pnl, 12, "BOS / MSS", stEvBar < 0 ? "-" : stEvTxt + " · hace " + str.tostring(bar_index - stEvBar) + " velas", stEvBar < 0 ? color.new(color.silver, 0) : stEvDir == 1 ? color.new(color.lime, 0) : color.new(color.red, 0))
        if showStats
            // verde = POT calibrado (hit-rate ~ POT medio), rojo = POT sobreestima, naranja = POT subestima (con n >= 20)
            color accCol = color.new(color.silver, 0)
            if stNt >= 20
                float accDif = (stHt - stPt) / stNt
                accCol := math.abs(accDif) <= 0.07 ? color.new(color.lime, 0) : accDif < 0 ? color.new(color.red, 0) : color.new(color.orange, 0)
            f_row(pnl, 13, "Acierto POT", accTxt, accCol)
            f_row(pnl, 14, "Tramos <50/50-70/≥70", f_bkTxt(0) + " / " + f_bkTxt(1) + " / " + f_bkTxt(2), color.new(color.white, 0))

// =====================================================================
//  MODULO 2: PERFIL DE VOLUMEN - COMPRAS (verde) vs VENTAS (rojo)
//  Independiente del modulo DOL: estado, dibujos y tabla propios (prefijo "vp").
//  Reparto compra/venta: con "vpUseDelta" usa el delta de cada vela
//  (compra = (vol + delta)/2, venta = (vol - delta)/2); si no, cierre >= apertura = compra.
//  El volumen de cada vela se reparte proporcionalmente entre las filas que toca.
// =====================================================================
var array<box>   vpBoxes  = array.new<box>()
var array<line>  vpLines  = array.new<line>()
var array<label> vpLabels = array.new<label>()
var table vpTbl = table.new(vpPosV, 2, 5, bgcolor=color.new(#131722, 10), frame_color=color.new(color.gray, 60), frame_width=1, border_color=color.new(color.gray, 70), border_width=1)

if barstate.islast
    // Limpiar solo los objetos del VP (los del DOL no se tocan)
    for vb in vpBoxes
        box.delete(vb)
    array.clear(vpBoxes)
    for vl in vpLines
        line.delete(vl)
    array.clear(vpLines)
    for vt in vpLabels
        label.delete(vt)
    array.clear(vpLabels)

    int vpN = math.min(vpLookback, bar_index + 1)
    float vpHi = high
    float vpLo = low
    if vpOn
        for i = 0 to vpN - 1
            vpHi := math.max(vpHi, high[i])
            vpLo := math.min(vpLo, low[i])

    float vpStep = (vpHi - vpLo) / vpRows

    if vpOn and vpStep > 0
        array<float> vpUp = array.new<float>(vpRows, 0.0)
        array<float> vpDn = array.new<float>(vpRows, 0.0)

        // Repartir el volumen de cada vela entre las filas que toca
        for i = 0 to vpN - 1
            float bh = high[i]
            float bl = low[i]
            float bv = nz(volume[i])
            bool isUp = close[i] >= open[i]
            // Compra / venta de la vela: por delta (compra = (vol + delta)/2) o por color de la vela
            float bvBuy = vpUseDelta ? math.max(0.0, math.min(bv, (bv + nz(barDelta[i])) / 2.0)) : (isUp ? bv : 0.0)
            float bvSell = bv - bvBuy
            float rng = bh - bl
            int idxLo = math.max(0, math.min(vpRows - 1, int(math.floor((bl - vpLo) / vpStep))))
            int idxHi = math.max(0, math.min(vpRows - 1, int(math.floor((bh - vpLo) / vpStep))))
            for r = idxLo to idxHi
                float rowLo = vpLo + r * vpStep
                float rowHi = rowLo + vpStep
                float overlap = math.min(bh, rowHi) - math.max(bl, rowLo)
                float portion = rng > 0 ? math.max(overlap, 0.0) / rng : 1.0 / (idxHi - idxLo + 1)
                vpUp.set(r, vpUp.get(r) + bvBuy * portion)
                vpDn.set(r, vpDn.get(r) + bvSell * portion)

        // Totales, POC y volumen total
        array<float> vpTot = array.new<float>(vpRows, 0.0)
        float vpMax = 0.0
        float vpSum = 0.0
        float vpSumUp = 0.0
        float vpSumDn = 0.0
        int vpPoc = 0
        for r = 0 to vpRows - 1
            float t = vpUp.get(r) + vpDn.get(r)
            vpTot.set(r, t)
            vpSum += t
            vpSumUp += vpUp.get(r)
            vpSumDn += vpDn.get(r)
            if t > vpMax
                vpMax := t
                vpPoc := r

        if vpMax > 0
            // Area de valor: se expande desde el POC hacia la fila vecina con mas volumen
            float vpRem = vpSum * vpVaPct - vpTot.get(vpPoc)
            int vaHiI = vpPoc
            int vaLoI = vpPoc
            while vpRem > 0
                float nUp = vaHiI + 1 < vpRows ? vpTot.get(vaHiI + 1) : -1.0
                float nDn = vaLoI - 1 >= 0 ? vpTot.get(vaLoI - 1) : -1.0
                if nUp < 0 and nDn < 0
                    break
                bool goUp = nUp >= nDn
                float cand = goUp ? nUp : nDn
                if cand > vpRem
                    break
                vpRem -= cand
                if goUp
                    vaHiI += 1
                else
                    vaLoI -= 1

            int vpX0 = vpPlace == "Derecha del precio" ? bar_index + vpGap : bar_index - vpN + 1
            int vpZL = bar_index - vpN + 1
            int vpZR = bar_index
            int vpXE = bar_index + vpGap + vpProfW

            // 1) Zonas sombreadas: verde = dominan compras, rojo = dominan ventas
            if vpShowZones
                for r = 0 to vpRows - 1
                    if vpTot.get(r) >= vpHvnPct * vpMax
                        float zLo = vpLo + r * vpStep
                        float zHi = zLo + vpStep
                        color zc = vpUp.get(r) >= vpDn.get(r) ? vpZoneBuy : vpZoneSell
                        vpBoxes.push(box.new(vpZL, zHi, vpZR, zLo, border_color=na, bgcolor=zc))

            // 2) Histograma: tramo de compra (verde) + tramo de venta (rojo)
            for r = 0 to vpRows - 1
                float rLo = vpLo + r * vpStep
                float rHi = rLo + vpStep
                bool inVA = r >= vaLoI and r <= vaHiI
                int uW = int(math.round(vpUp.get(r) / vpMax * vpProfW))
                int dW = int(math.round(vpDn.get(r) / vpMax * vpProfW))
                if uW > 0
                    vpBoxes.push(box.new(vpX0, rHi, vpX0 + uW, rLo, border_color=na, bgcolor=inVA ? vpVaBuyCol : vpBuyCol))
                if dW > 0
                    vpBoxes.push(box.new(vpX0 + uW, rHi, vpX0 + uW + dW, rLo, border_color=na, bgcolor=inVA ? vpVaSellCol : vpSellCol))

            // 3) POC, VAH, VAL
            float pocPx = vpLo + (vpPoc + 0.5) * vpStep
            float vahPx = vpLo + (vaHiI + 1) * vpStep
            float valPx = vpLo + vaLoI * vpStep
            if vpShowPoc
                vpLines.push(line.new(vpZL, pocPx, vpXE, pocPx, color=vpPocCol, width=2))
                vpLabels.push(label.new(vpXE, pocPx, "POC " + str.tostring(pocPx, format.mintick), style=label.style_label_left, color=color.new(vpPocCol, 100), textcolor=vpPocCol, size=size.small))
            if vpShowVa
                vpLines.push(line.new(vpZL, vahPx, vpXE, vahPx, color=vpVaCol, width=1, style=line.style_dashed))
                vpLines.push(line.new(vpZL, valPx, vpXE, valPx, color=vpVaCol, width=1, style=line.style_dashed))
                vpLabels.push(label.new(vpXE, vahPx, "VAH " + str.tostring(vahPx, format.mintick), style=label.style_label_left, color=color.new(vpVaCol, 100), textcolor=vpVaCol, size=size.small))
                vpLabels.push(label.new(vpXE, valPx, "VAL " + str.tostring(valPx, format.mintick), style=label.style_label_left, color=color.new(vpVaCol, 100), textcolor=vpVaCol, size=size.small))

            // 4) Tabla de resumen VP (reutiliza f_row, solo para dar formato)
            if vpShowTbl
                float buyPct = vpSumUp / vpSum * 100.0
                float sellPct = vpSumDn / vpSum * 100.0
                bool buyBias = buyPct >= sellPct
                f_row(vpTbl, 0, "VP Compras", str.tostring(buyPct, "#.0") + "%", color.green)
                f_row(vpTbl, 1, "VP Ventas", str.tostring(sellPct, "#.0") + "%", color.red)
                f_row(vpTbl, 2, "VP Sesgo", buyBias ? "COMPRADOR" : "VENDEDOR", buyBias ? color.green : color.red)
                f_row(vpTbl, 3, "Precio vs POC", close >= pocPx ? "Encima" : "Debajo", close >= pocPx ? color.green : color.red)
                f_row(vpTbl, 4, "Precio vs VA", close > vahPx ? "Sobre VAH" : close < valPx ? "Bajo VAL" : "Dentro", color.white)

// =====================================================================
//  MODULO 3: ORDER FLOW
//  Estado propio (prefijo "ofl"). Solo LEE barDelta del modulo DOL
//  (delta intrabar; si no hay datos intrabar usa el proxy del DOL).
//   - Delta extremo: delta de la vela > N desviaciones, a favor de la vela.
//   - Absorcion: delta extremo en contra y la vela cierra en sentido contrario
//     (agresores absorbidos por ordenes pasivas) -> posible giro.
//   - Divergencia (ventana): precio hace nuevo extremo y el CVD no lo confirma.
//   - Divergencia (pivotes): pivote de precio mas alto/bajo sin confirmacion del CVD.
//   - Delta %: delta / volumen. <5% balance, >=10% iniciativa.
//   - Delta flip: el delta cambia de signo con delta% significativo.
//   - Rechazo: el delta intravela llego lejos (max/min) y la vela cerro lejos de ese extremo.
//   - Agotamiento: delta extremo seguido de vela de giro con delta contrario.
//  Los eventos alimentan oflEvBias, que se mezcla en el score de Order Flow del POT.
// =====================================================================
var string oflLastTxt = "-"
var int    oflLastBar = -1
var table  oflTbl = table.new(oflPosV, 2, 8, bgcolor=color.new(#131722, 10), frame_color=color.new(color.gray, 60), frame_width=1, border_color=color.new(color.gray, 70), border_width=1)
var float  oflLPhPx = na
var float  oflLPhCv = na
var float  oflLPlPx = na
var float  oflLPlCv = na

float oflDelta = nz(barDelta)
float oflCvd   = ta.cum(oflDelta)
float oflSd    = ta.stdev(oflDelta, oflStdLen)
float oflPxHi  = ta.highest(high, oflDivLen)
float oflPxLo  = ta.lowest(low, oflDivLen)
float oflCvHi  = ta.highest(oflCvd, oflDivLen)
float oflCvLo  = ta.lowest(oflCvd, oflDivLen)
float oflMidP  = (high + low) / 2.0
float oflPct   = volume > 0 ? oflDelta / volume * 100.0 : 0.0
float oflPh    = ta.pivothigh(high, oflPvLen, oflPvLen)
float oflPl    = ta.pivotlow(low, oflPvLen, oflPvLen)

bool oflImbBuy  = oflOn and oflSd > 0 and oflDelta > oflImbMult * oflSd and close > open
bool oflImbSell = oflOn and oflSd > 0 and oflDelta < -oflImbMult * oflSd and close < open
bool oflAbsBuy  = oflOn and oflSd > 0 and oflDelta < -oflImbMult * oflSd and close >= open and close > oflMidP
bool oflAbsSell = oflOn and oflSd > 0 and oflDelta > oflImbMult * oflSd and close <= open and close < oflMidP
bool oflDivBearRaw = oflOn and bar_index > oflDivLen and high > oflPxHi[1] and oflCvd < oflCvHi[1]
bool oflDivBullRaw = oflOn and bar_index > oflDivLen and low < oflPxLo[1] and oflCvd > oflCvLo[1]

// Delta flip: cambio de signo con delta% significativo (la vela previa tambien debe salir del balance)
float oflPctPrev = nz(oflPct[1])
bool oflFlipBuy  = oflOn and oflDelta > 0 and nz(oflDelta[1]) < 0 and oflPct >= oflPctInit and oflPctPrev <= -oflPctBal
bool oflFlipSell = oflOn and oflDelta < 0 and nz(oflDelta[1]) > 0 and oflPct <= -oflPctInit and oflPctPrev >= oflPctBal

// Rechazo: el delta intravela llego a un extremo y la vela cerro lejos de el (solo con datos intrabar)
bool oflFadeUp = oflOn and oflSd > 0 and dMax > oflImbMult * oflSd and oflDelta < oflFadeRatio * dMax
bool oflFadeDn = oflOn and oflSd > 0 and dMin < -oflImbMult * oflSd and oflDelta > oflFadeRatio * dMin

// Agotamiento: delta extremo en la vela previa y vela de giro con delta contrario
bool oflExhBuy  = oflOn and oflImbBuy[1] and close < open and oflDelta < 0
bool oflExhSell = oflOn and oflImbSell[1] and close > open and oflDelta > 0

bool oflEvImbBuy  = barstate.isconfirmed and oflImbBuy
bool oflEvImbSell = barstate.isconfirmed and oflImbSell
bool oflEvAbsBuy  = barstate.isconfirmed and oflAbsBuy
bool oflEvAbsSell = barstate.isconfirmed and oflAbsSell
bool oflEvDivBear = barstate.isconfirmed and oflDivBearRaw and not oflDivBearRaw[1]
bool oflEvDivBull = barstate.isconfirmed and oflDivBullRaw and not oflDivBullRaw[1]
bool oflEvFlipBuy  = barstate.isconfirmed and oflFlipBuy
bool oflEvFlipSell = barstate.isconfirmed and oflFlipSell
bool oflEvFadeUp   = barstate.isconfirmed and oflFadeUp and not oflAbsSell
bool oflEvFadeDn   = barstate.isconfirmed and oflFadeDn and not oflAbsBuy
bool oflEvExhBuy   = barstate.isconfirmed and oflExhBuy
bool oflEvExhSell  = barstate.isconfirmed and oflExhSell

// Divergencia CVD por pivotes: se confirma oflPvLen velas despues del pivote (el marcador se dibuja sobre el pivote)
bool oflEvPDivBear = false
bool oflEvPDivBull = false
if barstate.isconfirmed and oflOn and not na(oflPh)
    float cvAtH = oflCvd[oflPvLen]
    if not na(oflLPhPx) and oflPh > oflLPhPx and cvAtH < oflLPhCv
        oflEvPDivBear := true
    oflLPhPx := oflPh
    oflLPhCv := cvAtH
if barstate.isconfirmed and oflOn and not na(oflPl)
    float cvAtL = oflCvd[oflPvLen]
    if not na(oflLPlPx) and oflPl < oflLPlPx and cvAtL > oflLPlCv
        oflEvPDivBull := true
    oflLPlPx := oflPl
    oflLPlCv := cvAtL

if oflEvPDivBear
    oflLastTxt := "Divergencia CVD pivotes bajista ◆"
    oflLastBar := bar_index
else if oflEvPDivBull
    oflLastTxt := "Divergencia CVD pivotes alcista ◆"
    oflLastBar := bar_index
else if oflEvDivBear
    oflLastTxt := "Divergencia bajista ◆"
    oflLastBar := bar_index
else if oflEvDivBull
    oflLastTxt := "Divergencia alcista ◆"
    oflLastBar := bar_index
else if oflEvAbsBuy
    oflLastTxt := "Absorcion alcista ●"
    oflLastBar := bar_index
else if oflEvAbsSell
    oflLastTxt := "Absorcion bajista ●"
    oflLastBar := bar_index
else if oflEvExhBuy
    oflLastTxt := "Agotamiento comprador ✖"
    oflLastBar := bar_index
else if oflEvExhSell
    oflLastTxt := "Agotamiento vendedor ✖"
    oflLastBar := bar_index
else if oflEvFadeUp
    oflLastTxt := "Rechazo de compradores (delta max)"
    oflLastBar := bar_index
else if oflEvFadeDn
    oflLastTxt := "Rechazo de vendedores (delta min)"
    oflLastBar := bar_index
else if oflEvImbBuy
    oflLastTxt := "Delta compra extremo ▲"
    oflLastBar := bar_index
else if oflEvImbSell
    oflLastTxt := "Delta venta extremo ▼"
    oflLastBar := bar_index
else if oflEvFlipBuy
    oflLastTxt := "Delta flip a compra"
    oflLastBar := bar_index
else if oflEvFlipSell
    oflLastTxt := "Delta flip a venta"
    oflLastBar := bar_index

// Sesgo por eventos para el POT: absorcion/divergencia/rechazo/agotamiento/flip (decae 10% por vela)
oflEvBias := math.max(-1.0, math.min(1.0, oflEvBias * 0.9 + (oflEvAbsBuy ? 0.6 : 0.0) - (oflEvAbsSell ? 0.6 : 0.0) + (oflEvDivBull ? 0.4 : 0.0) - (oflEvDivBear ? 0.4 : 0.0) + (oflEvPDivBull ? 0.5 : 0.0) - (oflEvPDivBear ? 0.5 : 0.0) + (oflEvFlipBuy ? 0.3 : 0.0) - (oflEvFlipSell ? 0.3 : 0.0) + (oflEvFadeDn ? 0.4 : 0.0) - (oflEvFadeUp ? 0.4 : 0.0) - (oflEvExhBuy ? 0.5 : 0.0) + (oflEvExhSell ? 0.5 : 0.0)))

plotshape(oflShowImb and oflEvImbBuy, title="OF: Delta compra extremo", style=shape.triangleup, location=location.belowbar, color=oflBuyCol, size=size.tiny)
plotshape(oflShowImb and oflEvImbSell, title="OF: Delta venta extremo", style=shape.triangledown, location=location.abovebar, color=oflSellCol, size=size.tiny)
plotshape(oflShowAbs and oflEvAbsBuy, title="OF: Absorcion alcista", style=shape.circle, location=location.belowbar, color=oflBuyCol, size=size.tiny, text="Abs", textcolor=oflBuyCol)
plotshape(oflShowAbs and oflEvAbsSell, title="OF: Absorcion bajista", style=shape.circle, location=location.abovebar, color=oflSellCol, size=size.tiny, text="Abs", textcolor=oflSellCol)
plotshape(oflShowDiv and oflEvDivBull, title="OF: Divergencia alcista", style=shape.diamond, location=location.belowbar, color=oflBuyCol, size=size.tiny, text="Div", textcolor=oflBuyCol)
plotshape(oflShowDiv and oflEvDivBear, title="OF: Divergencia bajista", style=shape.diamond, location=location.abovebar, color=oflSellCol, size=size.tiny, text="Div", textcolor=oflSellCol)
plotshape(oflShowDiv and oflEvPDivBull, title="OF: Divergencia CVD pivotes alcista", style=shape.diamond, location=location.belowbar, color=oflBuyCol, size=size.small, offset=-oflPvLen)
plotshape(oflShowDiv and oflEvPDivBear, title="OF: Divergencia CVD pivotes bajista", style=shape.diamond, location=location.abovebar, color=oflSellCol, size=size.small, offset=-oflPvLen)
plotshape(oflShowNew and oflEvFlipBuy, title="OF: Delta flip a compra", style=shape.labelup, location=location.belowbar, color=oflBuyCol, size=size.tiny)
plotshape(oflShowNew and oflEvFlipSell, title="OF: Delta flip a venta", style=shape.labeldown, location=location.abovebar, color=oflSellCol, size=size.tiny)
plotshape(oflShowNew and oflEvFadeDn, title="OF: Rechazo de vendedores", style=shape.triangleup, location=location.belowbar, color=oflBuyCol, size=size.tiny)
plotshape(oflShowNew and oflEvFadeUp, title="OF: Rechazo de compradores", style=shape.triangledown, location=location.abovebar, color=oflSellCol, size=size.tiny)
plotshape(oflShowNew and oflEvExhSell, title="OF: Agotamiento vendedor", style=shape.xcross, location=location.belowbar, color=oflBuyCol, size=size.tiny)
plotshape(oflShowNew and oflEvExhBuy, title="OF: Agotamiento comprador", style=shape.xcross, location=location.abovebar, color=oflSellCol, size=size.tiny)

if barstate.islast and oflOn and oflShowTbl
    string oflSrc = array.size(ltV) > 1 ? "intrabar " + ltf : "proxy (sin datos intrabar)"
    string oflPres = ofScore >= 0.7 ? "COMPRADORA fuerte" : ofScore >= 0.3 ? "Compradora" : ofScore <= -0.7 ? "VENDEDORA fuerte" : ofScore <= -0.3 ? "Vendedora" : "Neutral"
    color oflPresCol = ofScore >= 0.3 ? color.lime : ofScore <= -0.3 ? color.red : color.silver
    string oflPctCls = math.abs(oflPct) < oflPctBal ? "balance" : math.abs(oflPct) < oflPctInit ? "zona gris" : (oflPct > 0 ? "iniciativa compra" : "iniciativa venta")
    f_row(oflTbl, 0, "Order Flow", oflSrc, color.white)
    f_row(oflTbl, 1, "Delta vela", str.tostring(oflDelta, format.volume), oflDelta >= 0 ? color.lime : color.red)
    f_row(oflTbl, 2, "Delta " + str.tostring(ofLen) + " velas", str.tostring(dSum, format.volume) + " (" + str.tostring(flow * 100.0, "0.0") + "%)", dSum >= 0 ? color.lime : color.red)
    f_row(oflTbl, 3, "CVD", str.tostring(oflCvd, format.volume) + (oflCvd > nz(oflCvd[ofLen]) ? "  ↑" : "  ↓"), oflCvd > nz(oflCvd[ofLen]) ? color.lime : color.red)
    f_row(oflTbl, 4, "Presion", oflPres, oflPresCol)
    f_row(oflTbl, 5, "Ultimo evento", oflLastBar < 0 ? "-" : oflLastTxt + " · hace " + str.tostring(bar_index - oflLastBar) + " velas", color.white)
    f_row(oflTbl, 6, "Delta %", str.tostring(oflPct, "0.0") + "% · " + oflPctCls, math.abs(oflPct) < oflPctBal ? color.silver : oflPct > 0 ? color.lime : color.red)
    f_row(oflTbl, 7, "Max / Min delta", str.tostring(dMax, format.volume) + " / " + str.tostring(dMin, format.volume), color.white)

// =====================================================================
//  MODULO 4: ORDER BLOCKS
//  Estado propio (prefijo "blk"). Deteccion independiente de los OB del DOL.
//   OB alcista = ultima vela bajista antes de la ruptura alcista de estructura
//   OB bajista = ultima vela alcista antes de la ruptura bajista de estructura
//  Se invalida segun el modo elegido; cada entrada del precio cuenta como test.
// =====================================================================
var float[] blkTop  = array.new_float(0)
var float[] blkBot  = array.new_float(0)
var int[]   blkDir  = array.new_int(0)
var int[]   blkBorn = array.new_int(0)
var int[]   blkTest = array.new_int(0)
var float[] blkVr   = array.new_float(0)
var float[] blkDl   = array.new_float(0)
var float blkPH = na
var float blkPL = na
var bool  blkPHbrk = true
var bool  blkPLbrk = true
var array<box>   blkBoxes  = array.new<box>()
var array<line>  blkLines  = array.new<line>()
var array<label> blkLabels = array.new<label>()

f_blkRm(i) =>
    array.remove(blkTop, i)
    array.remove(blkBot, i)
    array.remove(blkDir, i)
    array.remove(blkBorn, i)
    array.remove(blkTest, i)
    array.remove(blkVr, i)
    array.remove(blkDl, i)

f_blkAdd(pT, pB, pDir, pBorn, pVr, pDl) =>
    bool dup = false
    int n = array.size(blkBorn)
    if n > 0
        for k = 0 to n - 1
            if array.get(blkBorn, k) == pBorn and array.get(blkDir, k) == pDir
                dup := true
                break
    if not dup
        array.push(blkTop, pT)
        array.push(blkBot, pB)
        array.push(blkDir, pDir)
        array.push(blkBorn, pBorn)
        array.push(blkTest, 0)
        array.push(blkVr, pVr)
        array.push(blkDl, pDl)
        if array.size(blkTop) > blkMaxTrack
            f_blkRm(0)
    not dup

// Series auxiliares (se evaluan en todas las barras)
float blkBphN   = ta.pivothigh(high, blkPivot, blkPivot)
float blkBplN   = ta.pivotlow(low, blkPivot, blkPivot)
int   blkLowOff = -ta.lowestbars(low, blkLook)
int   blkHiOff  = -ta.highestbars(high, blkLook)
float blkVolAvg = ta.sma(nz(volume), 20)

if not na(blkBphN)
    blkPH := blkBphN
    blkPHbrk := false
if not na(blkBplN)
    blkPL := blkBplN
    blkPLbrk := false

bool blkNewBull = false
bool blkNewBear = false
bool blkTapBull = false
bool blkTapBear = false

// ---- Ciclo de vida: invalidacion, tests y retests (solo barras cerradas) ----
if barstate.isconfirmed and blkOn
    int nBk = array.size(blkTop)
    if nBk > 0
        for i = nBk - 1 to 0
            float bkT = array.get(blkTop, i)
            float bkB = array.get(blkBot, i)
            int bkD = array.get(blkDir, i)
            int bkBorn = array.get(blkBorn, i)
            float bkMid = (bkT + bkB) / 2.0
            bool bkInv = bkD == 1 ? (blkMitMode == "Cierre" ? close < bkB : low < bkB) : (blkMitMode == "Cierre" ? close > bkT : high > bkT)
            bool bkOld = bar_index - bkBorn > blkMaxAge
            if bkInv or bkOld
                f_blkRm(i)
            else if bar_index > bkBorn + 1
                if bkD == 1
                    if low <= bkT
                        if low[1] > bkT
                            array.set(blkTest, i, array.get(blkTest, i) + 1)
                        if close >= bkMid
                            blkTapBull := true
                else
                    if high >= bkB
                        if high[1] < bkB
                            array.set(blkTest, i, array.get(blkTest, i) + 1)
                        if close <= bkMid
                            blkTapBear := true

// ---- Deteccion: BOS alcista -> OB alcista ----
if barstate.isconfirmed and blkOn and not na(atrVal) and not na(blkPH) and not blkPHbrk and close > blkPH
    blkPHbrk := true
    int blkKb = -1
    for j = blkLowOff to math.min(blkLowOff + 3, blkLook + 2)
        if close[j] < open[j]
            blkKb := j
            break
    if blkKb >= 0
        float blkTb = blkBodyOnly ? math.max(open[blkKb], close[blkKb]) : high[blkKb]
        float blkBb = blkBodyOnly ? math.min(open[blkKb], close[blkKb]) : low[blkKb]
        float blkSzb = (blkTb - blkBb) / atrVal
        if blkSzb >= blkMinAtr and blkSzb <= blkMaxAtrSz
            float blkAvgB = nz(blkVolAvg[blkKb])
            float blkVrB = blkAvgB > 0 ? nz(volume[blkKb]) / blkAvgB : 1.0
            if f_blkAdd(blkTb, blkBb, 1, bar_index - blkKb, blkVrB, nz(barDelta[blkKb]))
                blkNewBull := true

// ---- Deteccion: BOS bajista -> OB bajista ----
if barstate.isconfirmed and blkOn and not na(atrVal) and not na(blkPL) and not blkPLbrk and close < blkPL
    blkPLbrk := true
    int blkKs = -1
    for j = blkHiOff to math.min(blkHiOff + 3, blkLook + 2)
        if close[j] > open[j]
            blkKs := j
            break
    if blkKs >= 0
        float blkTs = blkBodyOnly ? math.max(open[blkKs], close[blkKs]) : high[blkKs]
        float blkBs = blkBodyOnly ? math.min(open[blkKs], close[blkKs]) : low[blkKs]
        float blkSzs = (blkTs - blkBs) / atrVal
        if blkSzs >= blkMinAtr and blkSzs <= blkMaxAtrSz
            float blkAvgS = nz(blkVolAvg[blkKs])
            float blkVrS = blkAvgS > 0 ? nz(volume[blkKs]) / blkAvgS : 1.0
            if f_blkAdd(blkTs, blkBs, -1, bar_index - blkKs, blkVrS, nz(barDelta[blkKs]))
                blkNewBear := true

// ---- Marcas de retest ----
plotshape(blkShowTap and blkTapBull, title="OB: retest alcista", style=shape.arrowup, location=location.belowbar, color=blkBullCol, size=size.small, text="OB+", textcolor=blkBullCol)
plotshape(blkShowTap and blkTapBear, title="OB: retest bajista", style=shape.arrowdown, location=location.abovebar, color=blkBearCol, size=size.small, text="OB-", textcolor=blkBearCol)

// ---- Dibujo (solo ultima barra; no toca los objetos del DOL ni del VP) ----
if barstate.islast
    for bx in blkBoxes
        box.delete(bx)
    array.clear(blkBoxes)
    for ln2 in blkLines
        line.delete(ln2)
    array.clear(blkLines)
    for lb2 in blkLabels
        label.delete(lb2)
    array.clear(blkLabels)
    if blkOn
        int nDw = array.size(blkTop)
        if nDw > 0
            for i = 0 to nDw - 1
                float dT = array.get(blkTop, i)
                float dB = array.get(blkBot, i)
                int dD = array.get(blkDir, i)
                int dTst = array.get(blkTest, i)
                int dL = math.max(array.get(blkBorn, i), bMin)
                int dR = bar_index + 12
                color dC = dD == 1 ? blkBullCol : blkBearCol
                float dM = (dT + dB) / 2.0
                array.push(blkBoxes, box.new(dL, dT, dR, dB, border_color=color.new(dC, 30), border_width=1, bgcolor=color.new(dC, math.min(95, 80 + dTst * 5))))
                if blkShowMid
                    array.push(blkLines, line.new(dL, dM, dR, dM, color=color.new(dC, 30), style=line.style_dotted, width=1))
                if blkShowLbl
                    string dTxt = (dD == 1 ? "OB+ " : "OB- ") + str.tostring(array.get(blkVr, i), "0.0") + "x vol" + (array.get(blkDl, i) >= 0 ? " Δ+" : " Δ-") + (dTst > 0 ? " · test " + str.tostring(dTst) : "")
                    array.push(blkLabels, label.new(dR, dM, dTxt, style=label.style_label_left, color=color.new(dC, 100), textcolor=dC, size=size.tiny))

// =====================================================================
//  MODULO 5: SESSION HIGHS & LOWS (Asia / London / New York)
//  Estado propio (prefijos "s" y "ses"). Solo intradia.
//   - Al cerrar cada barra se actualiza el rango de la sesion en curso; al terminar se archiva.
//   - Se dibuja: sesion en vivo (o la mas reciente de su tipo) brillante y proyectada; anteriores atenuadas.
//   - Los extremos de la ultima sesion completada alimentan el DOL (ver f_nearLiq / f_eval / barridas).
// =====================================================================
var array<line>  sesLn  = array.new<line>()
var array<label> sesLb  = array.new<label>()
var array<box>   sesBx  = array.new<box>()
var table sesTbl = table.new(sesPosV, 5, 5, bgcolor=color.new(#131722, 10), frame_color=color.new(color.gray, 60), frame_width=1, border_color=color.new(color.gray, 70), border_width=1)

f_inSes(h, tz) =>
    not na(time(timeframe.period, h, tz))

bool sesWin = bar_index >= last_bar_index - 3000   // las sesiones solo se calculan en las ultimas 3000 velas
bool sInA = sesWin and f_inSes(sesAsiaHrs, sesAsiaTz)
bool sInL = sesWin and f_inSes(sesLdnHrs, sesLdnTz)
bool sInN = sesWin and f_inSes(sesNyHrs, sesNyTz)

if barstate.isconfirmed and sesOn and timeframe.isintraday
    bool[] inArr = array.from(sInA, sInL, sInN)
    bool[] enArr = array.from(sesAsiaOn, sesLdnOn, sesNyOn)
    for k = 0 to 2
        bool inNow = array.get(inArr, k) and array.get(enArr, k)
        bool was = array.get(sAct, k)
        if inNow
            if not was
                array.set(sCH, k, high)
                array.set(sCL, k, low)
                array.set(sCB0, k, bar_index)
                array.set(sAct, k, true)
            else
                array.set(sCH, k, math.max(array.get(sCH, k), high))
                array.set(sCL, k, math.min(array.get(sCL, k), low))
            array.set(sCB1, k, bar_index)
        else if was
            array.push(sPK, k)
            array.push(sPH, array.get(sCH, k))
            array.push(sPL, array.get(sCL, k))
            array.push(sPB0, array.get(sCB0, k))
            array.push(sPB1, array.get(sCB1, k))
            array.set(sesLastH, k, array.get(sCH, k))
            array.set(sesLastL, k, array.get(sCL, k))
            array.set(sAct, k, false)
            int cntK = 0
            int firstK = -1
            for j = 0 to array.size(sPK) - 1
                if array.get(sPK, j) == k
                    cntK += 1
                    if firstK == -1
                        firstK := j
            if cntK > sesKeep + 1 and firstK >= 0
                array.remove(sPK, firstK)
                array.remove(sPH, firstK)
                array.remove(sPL, firstK)
                array.remove(sPB0, firstK)
                array.remove(sPB1, firstK)

// Dibuja un nivel (linea + etiqueta). right = nivel vivo/proyectado (etiqueta a la derecha, linea gruesa);
// si no, etiqueta a la izquierda, donde abrio la sesion (arriba del nivel si es high, abajo si es low).
f_sesBox(x0raw, x1, hi, lo, col) =>
    if x1 > bMin
        array.push(sesBx, box.new(math.max(x0raw, bMin), hi, x1, lo, border_color=color.new(col, 70), border_width=1, bgcolor=color.new(col, 90)))

f_sesLevel(px, x0raw, x1, col, right, isHigh, tag) =>
    int x0 = math.max(x0raw, bMin)
    array.push(sesLn, line.new(x0, px, x1, px, color=col, width=right ? 2 : 1))
    string t = sesLblMode == "Solo precio" ? str.tostring(px, format.mintick) : tag + (isHigh ? " H " : " L ") + str.tostring(px, format.mintick)
    if right
        array.push(sesLb, label.new(x1, px, t, style=label.style_label_left, color=color.new(col, 100), textcolor=col, size=size.small))
    else
        array.push(sesLb, label.new(x0, px, t, style=isHigh ? label.style_label_down : label.style_label_up, color=color.new(col, 100), textcolor=col, size=size.tiny))

if barstate.islast
    for sl0 in sesLn
        line.delete(sl0)
    array.clear(sesLn)
    for sb0 in sesLb
        label.delete(sb0)
    array.clear(sesLb)
    for sx0 in sesBx
        box.delete(sx0)
    array.clear(sesBx)
    if sesOn and timeframe.isintraday
        int xRs = bar_index + 12
        bool[] inNowA = array.from(sInA, sInL, sInN)
        bool[] enA = array.from(sesAsiaOn, sesLdnOn, sesNyOn)
        color[] cLiveA = array.from(sesAsiaCol, sesLdnCol, sesNyCol)
        color[] cPastA = array.from(sesAsiaPast, sesLdnPast, sesNyPast)
        string[] nmA = array.from("ASIA", "LDN", "NY")
        string[] nmLongA = array.from("Asia", "London", "New York")
        if sesShowTbl
            table.cell(sesTbl, 0, 0, "Sesion", text_color=color.white, text_halign=text.align_left, text_size=size.small)
            table.cell(sesTbl, 1, 0, "High", text_color=color.white, text_halign=text.align_left, text_size=size.small)
            table.cell(sesTbl, 2, 0, "Low", text_color=color.white, text_halign=text.align_left, text_size=size.small)
            table.cell(sesTbl, 3, 0, "Rango", text_color=color.white, text_halign=text.align_left, text_size=size.small)
            table.cell(sesTbl, 4, 0, "Rango %", text_color=color.white, text_halign=text.align_left, text_size=size.small)
        int nP = array.size(sPK)
        for k = 0 to 2
            bool en = array.get(enA, k)
            bool nowIn = array.get(inNowA, k) and en
            color cl = array.get(cLiveA, k)
            color cp = array.get(cPastA, k)
            string nm = array.get(nmA, k)
            int lastJ = -1
            if en and nP > 0
                for j = 0 to nP - 1
                    if array.get(sPK, j) == k
                        lastJ := j
            if en and nP > 0
                for j = 0 to nP - 1
                    if array.get(sPK, j) == k and (array.get(sPB1, j) >= bMin or (j == lastJ and not nowIn))
                        bool bright = j == lastJ and not nowIn
                        int jb1 = math.max(bright and sesProject ? xRs : array.get(sPB1, j), bMin + 1)   // la sesion mas reciente siempre se dibuja, recortada a la ventana visible
                        if sesShade
                            f_sesBox(array.get(sPB0, j), array.get(sPB1, j), array.get(sPH, j), array.get(sPL, j), bright ? cl : cp)
                        f_sesLevel(array.get(sPH, j), array.get(sPB0, j), jb1, bright ? cl : cp, bright, true, nm)
                        f_sesLevel(array.get(sPL, j), array.get(sPB0, j), jb1, bright ? cl : cp, bright, false, nm)
            float vH = na
            float vL = na
            if nowIn
                bool act = array.get(sAct, k)
                vH := act ? math.max(array.get(sCH, k), high) : high
                vL := act ? math.min(array.get(sCL, k), low) : low
                int vb0 = act ? array.get(sCB0, k) : bar_index
                if sesShade
                    f_sesBox(vb0, bar_index, vH, vL, cl)
                f_sesLevel(vH, vb0, xRs, cl, true, true, nm)
                f_sesLevel(vL, vb0, xRs, cl, true, false, nm)
            else if lastJ >= 0
                vH := array.get(sPH, lastJ)
                vL := array.get(sPL, lastJ)
            if sesShowTbl
                int r = k + 1
                bool has = not na(vH) and not na(vL)
                table.cell(sesTbl, 0, r, (nowIn ? "● " : "") + array.get(nmLongA, k), text_color=cl, text_halign=text.align_left, text_size=size.small)
                table.cell(sesTbl, 1, r, has ? str.tostring(vH, format.mintick) : "-", text_color=color.white, text_halign=text.align_left, text_size=size.small)
                table.cell(sesTbl, 2, r, has ? str.tostring(vL, format.mintick) : "-", text_color=color.white, text_halign=text.align_left, text_size=size.small)
                table.cell(sesTbl, 3, r, has ? str.tostring(vH - vL, format.mintick) : "-", text_color=color.white, text_halign=text.align_left, text_size=size.small)
                table.cell(sesTbl, 4, r, has and vL > 0 ? str.tostring((vH - vL) / vL * 100.0, "0.00") + "%" : "-", text_color=color.white, text_halign=text.align_left, text_size=size.small)
        if sesShowTbl
            table.cell(sesTbl, 0, 4, "Estado", text_color=color.new(color.silver, 0), text_halign=text.align_left, text_size=size.small)
            table.cell(sesTbl, 1, 4, "TF " + timeframe.period + " · guardadas " + str.tostring(nP) + " · ahora: " + (sInA ? "Asia " : "") + (sInL ? "London " : "") + (sInN ? "NY" : "") + ((sInA or sInL or sInN) ? "" : "ninguna"), text_color=color.new(color.silver, 0), text_halign=text.align_left, text_size=size.small)
            table.merge_cells(sesTbl, 1, 4, 4, 4)
    else if sesShowTbl
        table.cell(sesTbl, 0, 0, "Sesiones: solo graficos intradia", text_color=color.new(color.silver, 0), text_halign=text.align_left, text_size=size.small)

// POT % y BBR % solo en barra de estado / Data Window (no dibujan nada en el grafico)
plot(pShown * 100.0, title="POT", display=display.status_line + display.data_window)
plot(bbrSm * 100.0, title="BBR", display=display.status_line + display.data_window)

