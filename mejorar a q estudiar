// Agrega un pool BSL/SSL; si hay otro a distancia <= tolerancia se fusiona (EQH/EQL)
f_addLiq(px, dir, pTime) =>
    bool merged = false
    int n = array.size(liqPx)
    if n > 0
        for k = 0 to n - 1
            if array.get(liqDir, k) == dir and math.abs(array.get(liqPx, k) - px) <= eqTolAtr * nz(atrVal)
                float cur = array.get(liqPx, k)
                array.set(liqPx, k, dir == 1 ? math.max(cur, px) : math.min(cur, px))
                array.set(liqStr, k, array.get(liqStr, k) + 1)
                merged := true
                break
    if not merged
        array.push(liqPx, px)
        array.push(liqDir, dir)
        array.push(liqStr, 1)
        array.push(liqTime, pTime)
        if array.size(liqPx) > maxLiq
            array.shift(liqPx)
            array.shift(liqDir)
            array.shift(liqStr)
            array.shift(liqTime)
    merged

// BSL mas cercano arriba (wantDir=1) o SSL mas cercano abajo (wantDir=-1). Incluye PDH/PDL.
