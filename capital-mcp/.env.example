# Copy this file to .env (same folder) and fill it in. NEVER upload .env to GitHub.
CAPITAL_API_KEY=your_api_key
CAPITAL_IDENTIFIER=your_capital_com_email
CAPITAL_PASSWORD=the_custom_password_of_the_api_key
# demo (default) or live
CAPITAL_ENV=demo
# optional: account id to use if you have several
# CAPITAL_ACCOUNT_ID=
